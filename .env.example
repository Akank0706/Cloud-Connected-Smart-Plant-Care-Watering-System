# ==========================================
# Cloud-Connected Smart Plant Care & Watering System
# Environment Configuration Template
# ==========================================

# Server Settings
PORT=3000
NODE_ENV=development
API_BASE_URL="http://localhost:3000"

# Device Ingestion Security
IOT_DEVICE_API_KEY="plant_secure_token_xyz987"
IOT_HEARTBEAT_TIMEOUT_SECONDS=180

# Automated Irrigation Parameters
DEFAULT_SOIL_THRESHOLD=35
DEFAULT_PUMP_DURATION_MS=3000
PUMP_COOLDOWN_SECONDS=300
MIN_WATER_TANK_LEVEL=15

# Python Backend (for FastAPI execution)
FASTAPI_PORT=8000
DATABASE_URL="sqlite:///./plant_care.db"

# Cloud Database / Firebase (Optional for cloud production)
FIREBASE_PROJECT_ID="smart-plant-care-cloud"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@smart-plant-care-cloud.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...-----END PRIVATE KEY-----\n"

# Gemini / Cloud Services (Injected by Cloud Run in production)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
